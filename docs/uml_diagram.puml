package "hu.prog2.fittrack.strategy" {
    interface CalorieCalculationStrategy <<interface>> {
        + calculateCalories(session: WorkoutSession, profile: UserProfile): double
        + getStrategyName(): String
        + getStrategyDescription(): String
    }

    class MetBasedStrategy implements CalorieCalculationStrategy {
        + calculateCalories(session: WorkoutSession, profile: UserProfile): double
        + getStrategyName(): String
        + getStrategyDescription(): String
    }

    class HeartRateStrategy implements CalorieCalculationStrategy {
        - fallbackStrategy: MetBasedStrategy
        + calculateCalories(session: WorkoutSession, profile: UserProfile): double
        + getStrategyName(): String
        + getStrategyDescription(): String
    }
}

